{
  "name": "aegispay-ai",
  "version": "1.0.0",
  "description": "AegisPay AI - Autonomous Multi-Agent Dispute Defense & Fraud Interception Platform for PayPal",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "cd server && node src/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "keywords": [
    "paypal",
    "hackathon",
    "dispute-defense",
    "multi-agent",
    "ai",
    "ag-grid",
    "fraud-prevention"
  ],
  "author": "AegisPay Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "openai": "^7.53.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
